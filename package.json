{
  "name": "consumidor-rag-mcp", "private": true, "version": "0.1.0", "type": "module",
  "packageManager": "pnpm@12.11.2", "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "pnpm --parallel --filter @consumidor/api --filter @consumidor/web dev",
    "build": "pnpm --filter @consumidor/shared build && pnpm --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck", "lint": "eslint .", "test": "vitest run",
    "test:e2e": "playwright test", "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "corpus": "pnpm --filter @consumidor/api corpus", "evaluate": "pnpm --filter @consumidor/api evaluate"
  },
  "devDependencies": {"typescript": "^5.9.3", "tsx": "^4.20.6", "vitest": "^3.2.4", "eslint": "^9.39.1", "typescript-eslint": "^8.46.2", "@playwright/test": "^1.56.1", "@types/node": "^24.10.0"}
}
